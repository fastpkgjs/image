{
  "name": "@fastpkg/image",
  "version": "0.6.1",
  "description": "Fast Rust image processing for Node.js, sharp-compatible, no libvips",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fastpkgjs/image"
  },
  "type": "module",
  "main": "./packages/image/index.cjs",
  "module": "./packages/image/index.js",
  "types": "./packages/image/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./packages/image/index.d.ts",
        "default": "./packages/image/index.js"
      },
      "require": {
        "types": "./packages/image/index.d.cts",
        "default": "./packages/image/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "packages/image/index.js",
    "packages/image/index.cjs",
    "packages/image/index.d.ts",
    "packages/image/index.d.cts",
    "packages/image/lib.cjs",
    "packages/image/image.*.node",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build:native": "node scripts/build.mjs",
    "build:native:debug": "node scripts/build.mjs --debug",
    "build": "npm run build:native",
    "fixtures": "node scripts/fixtures.mjs",
    "test": "node scripts/test.mjs",
    "bench": "node bench/run.mjs",
    "bench:sharp": "node bench/sharp.mjs",
    "test:types": "node tests/types/run.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8",
    "@types/node": "^24.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0"
  },
  "napi": {
    "binaryName": "image",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
